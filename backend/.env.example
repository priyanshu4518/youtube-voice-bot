GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models to try if the main one is overloaded (503) or rate limited (429)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Optional fallback if Gemini fails: OpenRouter (https://openrouter.ai/keys). Leave the key empty to disable.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Remove ":free" for the paid, higher-rate-limit versions.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free

# Text-to-speech (Cartesia). Get a key at https://play.cartesia.ai/keys
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=e07c00bc-4134-4eae-9ea4-1a55fb45746b
CARTESIA_LANGUAGE=en
