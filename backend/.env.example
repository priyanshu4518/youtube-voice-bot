GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models to try if the main one is overloaded (503) or rate limited (429)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Optional fallback if Gemini fails: OpenRouter (https://openrouter.ai/keys). Leave the key empty to disable.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Remove ":free" for the paid, higher-rate-limit versions.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free

# Text-to-speech (Cartesia). Get a key at https://play.cartesia.ai/keys
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=e07c00bc-4134-4eae-9ea4-1a55fb45746b
CARTESIA_LANGUAGE=en

# --- Latency tuning (all optional; see OPTIMIZATIONS.md) ---
# Gemini thinking level: "low" answers much sooner. Leave empty for the model's default (slower).
GEMINI_THINKING_LEVEL=low
# Seconds before a Gemini request is abandoned.
GEMINI_TIMEOUT_S=60
# If Gemini has produced no text after this many seconds, also ask OpenRouter and use whichever answers first.
# 0 disables hedging (OpenRouter is then only used after Gemini fails). Needs OPENROUTER_API_KEY.
LLM_HEDGE_AFTER_S=4
OPENROUTER_TIMEOUT_S=60
# "off" skips OpenRouter models' hidden reasoning (first token ~3x sooner). low/medium/high, or empty for default.
OPENROUTER_REASONING=off
CARTESIA_TIMEOUT_S=30
# Memory for cached speech audio (MB). Replaying an answer is instant and free.
TTS_CACHE_MB=64
# Videos whose index is kept in memory. Older ones are reloaded from the disk cache (backend/cache/).
INDEX_CACHE_SIZE=64
RETRIEVAL_TOP_K=5
