{
  "manifest_version": 3,
  "name": "YouTube AI Assistant",
  "version": "0.2.0",
  "description": "Ask questions about the YouTube video you are watching. Answers only use what has been said so far.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open YouTube AI Assistant" }
}
